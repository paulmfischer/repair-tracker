@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        <div @ref="_containerRef" style="width:100%;height:85vh;position:relative;overflow:hidden;"
             @onclick="ToggleZoom" @onmousemove="OnMouseMove">
            @if (_zoomed)
            {
                <div style="@ZoomedStyle"></div>
            }
            else
            {
                <img src="/@ImagePath" alt="Note image"
                     style="max-width:100%;max-height:85vh;display:block;margin:0 auto;object-fit:contain;cursor:zoom-in;" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Href="@("/" + ImagePath)" Target="_blank" StartIcon="@Icons.Material.Filled.OpenInNew">
            Open in New Tab
        </MudButton>
        <MudButton OnClick="@(() => MudDialog.Close())">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public string ImagePath { get; set; } = string.Empty;

    private ElementReference _containerRef;
    private IJSObjectReference? _module;
    private bool _zoomed;
    private double _containerWidth = 1;
    private double _containerHeight = 1;
    private double _percentX = 50;
    private double _percentY = 50;

    private string ZoomedStyle =>
        $"width:100%;height:100%;cursor:zoom-out;background-repeat:no-repeat;" +
        $"background-image:url('/{ImagePath}');background-size:200% auto;" +
        $"background-position:{_percentX.ToString(System.Globalization.CultureInfo.InvariantCulture)}% " +
        $"{_percentY.ToString(System.Globalization.CultureInfo.InvariantCulture)}%;";

    private async Task ToggleZoom()
    {
        if (!_zoomed)
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/imagePreview.js");
            var rect = await _module.InvokeAsync<ElementRect>("getElementRect", _containerRef);
            _containerWidth = rect.Width > 0 ? rect.Width : 1;
            _containerHeight = rect.Height > 0 ? rect.Height : 1;
            _percentX = 50;
            _percentY = 50;
        }
        _zoomed = !_zoomed;
    }

    private void OnMouseMove(MouseEventArgs e)
    {
        if (!_zoomed) return;
        _percentX = Math.Clamp(e.OffsetX / _containerWidth * 100, 0, 100);
        _percentY = Math.Clamp(e.OffsetY / _containerHeight * 100, 0, 100);
    }

    private sealed record ElementRect(double Width, double Height);
}
