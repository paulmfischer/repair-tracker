@using RepairTracker.Client.Services
@implements IDisposable
@inject IItemService ItemService
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject IDialogService DialogService
@inject ConnectivityService Connectivity

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Repair Log</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudTextField @bind-Value="_newNoteText" Label="Note" Lines="3" Class="mb-2" Immediate="true" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
            <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                           FilesChanged="OnNewNoteFilesChanged"
                           Disabled="@(!Connectivity.IsOnline)"
                           Accept=".jpg,.jpeg,.png,.gif,.webp">
                <ActivatorContent>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AttachFile" Disabled="@(!Connectivity.IsOnline)">
                        Attach Pictures
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudStack>
        @if (!Connectivity.IsOnline)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                Reconnect to attach pictures — text notes still work offline.
            </MudText>
        }
        @if (_newNoteFiles.Count > 0)
        {
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-1">
                @foreach (var file in _newNoteFiles)
                {
                    <MudChip T="string" Text="@file.Name" OnClose="@(() => RemoveNewNoteFile(file))" Color="Color.Secondary" Variant="Variant.Text" />
                }
            </MudStack>
        }
        @if (IsNew)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                This note (and any attached pictures) will be saved when you create the item.
            </MudText>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       OnClick="AddNote" Disabled="@(_addingNote || (string.IsNullOrWhiteSpace(_newNoteText) && _newNoteFiles.Count == 0))">
                @if (_addingNote)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Add Note
            </MudButton>
        }

        @if (Item.Notes.Any())
        {
            <MudDivider Class="my-4" />
            <MudTimeline TimelinePosition="TimelinePosition.Start" TimelineAlign="TimelineAlign.Start" Class="repair-log-timeline">
                @foreach (var note in Item.Notes.OrderByDescending(n => n.CreatedAt))
                {
                    <MudTimelineItem Color="@note.StatusAtTime.ToColor()" DotStyle="@note.StatusAtTime.ToColorStyle()"
                                     Variant="Variant.Filled" Size="Size.Small">
                        <ItemContent>
                            @if (_editingNoteId == note.Id)
                            {
                                <MudStack Spacing="2" Class="pb-4">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudChip T="string" Size="Size.Small" Color="@note.StatusAtTime.ToColor()"
                                                 Style="@note.StatusAtTime.ToColorStyle()" Variant="Variant.Filled">
                                            @note.StatusAtTime.ToDisplayString()
                                        </MudChip>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @note.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                        </MudText>
                                    </MudStack>
                                    <MudTextField @bind-Value="_editNoteText" Label="Note" Lines="3" Immediate="true" />
                                    @if (_editImagePaths.Count > 0)
                                    {
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                                            @for (var i = 0; i < _editImagePaths.Count; i++)
                                            {
                                                var index = i;
                                                <div style="position:relative;">
                                                    <img src="/@EditThumbSrc(index)" alt="Note image"
                                                         style="height:80px;width:80px;object-fit:cover;border-radius:4px;cursor:pointer;"
                                                         @onclick="@(() => OpenImagePreview(_editImagePaths[index]))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                                   Color="Color.Error" Variant="Variant.Filled"
                                                                   OnClick="@(() => RemoveEditImage(index))"
                                                                   Style="position:absolute;top:-10px;right:-10px;" />
                                                </div>
                                            }
                                        </MudStack>
                                    }
                                    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                                   FilesChanged="OnEditNoteFilesChanged"
                                                   Disabled="@(!Connectivity.IsOnline)"
                                                   Accept=".jpg,.jpeg,.png,.gif,.webp">
                                        <ActivatorContent>
                                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AttachFile" Disabled="@(!Connectivity.IsOnline)">
                                                Attach Pictures
                                            </MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                    @if (!Connectivity.IsOnline)
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                                            Reconnect to attach pictures — text notes still work offline.
                                        </MudText>
                                    }
                                    @if (_editNewFiles.Count > 0)
                                    {
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                                            @foreach (var file in _editNewFiles)
                                            {
                                                <MudChip T="string" Text="@file.Name" OnClose="@(() => RemoveEditNewFile(file))" Color="Color.Secondary" Variant="Variant.Text" />
                                            }
                                        </MudStack>
                                    }
                                    <MudStack Row="true" Spacing="2">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                   OnClick="@(() => SaveEditNote(note))"
                                                   Disabled="@(_savingEdit || (string.IsNullOrWhiteSpace(_editNoteText) && _editImagePaths.Count == 0 && _editNewFiles.Count == 0))">
                                            @if (_savingEdit)
                                            {
                                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                            }
                                            Save
                                        </MudButton>
                                        <MudButton Variant="Variant.Outlined" OnClick="CancelEditNote" Disabled="_savingEdit">
                                            Cancel
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            }
                            else
                            {
                                <MudStack Spacing="1" Class="pb-4">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudChip T="string" Size="Size.Small" Color="@note.StatusAtTime.ToColor()"
                                                 Style="@note.StatusAtTime.ToColorStyle()" Variant="Variant.Filled">
                                            @note.StatusAtTime.ToDisplayString()
                                        </MudChip>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @note.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                        </MudText>
                                        <MudSpacer />
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                       OnClick="@(() => StartEditNote(note))" />
                                    </MudStack>
                                    <MudText>@note.Text</MudText>
                                    @if (note.ImagePaths.Any())
                                    {
                                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                                            @for (var i = 0; i < note.ImagePaths.Count; i++)
                                            {
                                                var index = i;
                                                <img src="/@ThumbSrc(note, index)" alt="Note image"
                                                     style="height:80px;width:80px;object-fit:cover;border-radius:4px;cursor:pointer;"
                                                     @onclick="@(() => OpenImagePreview(note.ImagePaths[index]))" />
                                            }
                                        </MudStack>
                                    }
                                </MudStack>
                            }
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">No notes yet.</MudText>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public Item Item { get; set; } = null!;
    [Parameter] public bool IsNew { get; set; }

    protected override void OnInitialized()
    {
        // MainLayout's own re-render on connectivity change doesn't reliably cascade down to
        // this nested component, so it needs its own subscription to pick up the flip live.
        Connectivity.OnlineStatusChanged += OnConnectivityChanged;
    }

    private void OnConnectivityChanged(bool isOnline) => InvokeAsync(StateHasChanged);

    public void Dispose() => Connectivity.OnlineStatusChanged -= OnConnectivityChanged;

    private string _newNoteText = string.Empty;
    private List<IBrowserFile> _newNoteFiles = new();
    private bool _addingNote;

    private string? _editingNoteId;
    private string _editNoteText = string.Empty;
    private List<string> _editImagePaths = new();
    private List<string> _editThumbnailPaths = new();
    private List<string> _editRemovedImagePaths = new();
    private List<IBrowserFile> _editNewFiles = new();
    private bool _savingEdit;

    private static string ThumbSrc(RepairNote note, int index) =>
        index < note.ThumbnailPaths.Count && !string.IsNullOrEmpty(note.ThumbnailPaths[index])
            ? note.ThumbnailPaths[index]
            : note.ImagePaths[index];

    private string EditThumbSrc(int index) =>
        index < _editThumbnailPaths.Count && !string.IsNullOrEmpty(_editThumbnailPaths[index])
            ? _editThumbnailPaths[index]
            : _editImagePaths[index];

    private async Task OpenImagePreview(string imagePath)
    {
        var parameters = new DialogParameters<ImagePreviewDialog> { { x => x.ImagePath, imagePath } };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, CloseButton = true, FullWidth = true };
        await DialogService.ShowAsync<ImagePreviewDialog>("Image Preview", parameters, options);
    }

    private void OnNewNoteFilesChanged(IReadOnlyList<IBrowserFile> files)
    {
        _newNoteFiles.AddRange(files);
    }

    private void RemoveNewNoteFile(IBrowserFile file)
    {
        _newNoteFiles.Remove(file);
    }

    private async Task UploadNoteFilesAsync(RepairNote note, IEnumerable<IBrowserFile> files)
    {
        using var content = new MultipartFormDataContent();
        foreach (var file in files)
        {
            var streamContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024));
            content.Add(streamContent, "files", file.Name);
        }

        var response = await Http.PostAsync($"api/items/{Item.Id}/notes/{note.Id}/images", content);
        response.EnsureSuccessStatusCode();
        var result = await response.Content.ReadFromJsonAsync<ImageUploadResult>();
        note.ImagePaths.AddRange(result?.ImagePaths ?? []);
        note.ThumbnailPaths.AddRange(result?.ThumbnailPaths ?? []);
    }

    private async Task DeleteNoteImageAsync(string imagePath)
    {
        var response = await Http.DeleteAsync($"api/images?path={Uri.EscapeDataString(imagePath)}");
        response.EnsureSuccessStatusCode();
    }

    // Called by the parent page when creating a brand-new item, so the note is saved along with the item itself.
    public async Task<RepairNote?> BuildDraftNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_newNoteText) && _newNoteFiles.Count == 0) return null;

        var note = new RepairNote
        {
            Text = _newNoteText.Trim(),
            StatusAtTime = Item.Status,
            CreatedAt = DateTime.UtcNow
        };

        if (_newNoteFiles.Count > 0)
        {
            await UploadNoteFilesAsync(note, _newNoteFiles);
        }

        _newNoteText = string.Empty;
        _newNoteFiles = new();
        return note;
    }

    private async Task AddNote()
    {
        _addingNote = true;

        var note = await BuildDraftNoteAsync();
        if (note is not null)
        {
            Item.Notes.Add(note);
            await ItemService.UpdateAsync(Item);
            Snackbar.Add("Note added", Severity.Success);
        }

        _addingNote = false;
    }

    private void StartEditNote(RepairNote note)
    {
        _editingNoteId = note.Id;
        _editNoteText = note.Text;
        _editImagePaths = new List<string>(note.ImagePaths);
        _editThumbnailPaths = new List<string>(note.ThumbnailPaths);
        _editRemovedImagePaths = new();
        _editNewFiles = new();
    }

    private void CancelEditNote()
    {
        _editingNoteId = null;
        _editNoteText = string.Empty;
        _editImagePaths = new();
        _editThumbnailPaths = new();
        _editRemovedImagePaths = new();
        _editNewFiles = new();
    }

    private void RemoveEditImage(int index)
    {
        _editRemovedImagePaths.Add(_editImagePaths[index]);
        _editImagePaths.RemoveAt(index);
        if (index < _editThumbnailPaths.Count)
        {
            _editThumbnailPaths.RemoveAt(index);
        }
    }

    private void OnEditNoteFilesChanged(IReadOnlyList<IBrowserFile> files)
    {
        _editNewFiles.AddRange(files);
    }

    private void RemoveEditNewFile(IBrowserFile file)
    {
        _editNewFiles.Remove(file);
    }

    private async Task SaveEditNote(RepairNote note)
    {
        _savingEdit = true;

        note.Text = _editNoteText.Trim();
        note.ImagePaths = _editImagePaths;
        note.ThumbnailPaths = _editThumbnailPaths;

        if (_editNewFiles.Count > 0)
        {
            await UploadNoteFilesAsync(note, _editNewFiles);
        }

        foreach (var removed in _editRemovedImagePaths)
        {
            await DeleteNoteImageAsync(removed);
        }

        await ItemService.UpdateAsync(Item);
        Snackbar.Add("Note updated", Severity.Success);

        CancelEditNote();
        _savingEdit = false;
    }
}
