@page "/items/new"
@page "/items/{Id}"
@inject IItemService ItemService
@inject ISettingsService SettingsService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using RepairTracker.Client.Services

<PageTitle>@(_isNew ? "New Item" : _item?.Name ?? "Item")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/items" />
    <MudText Typo="Typo.h5">@(_isNew ? "New Item" : _item?.Name)</MudText>
</MudStack>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_item is not null)
{
    <MudGrid>
        <MudItem xs="12">
            @{ var activeBranch = RepairBranch.All.FirstOrDefault(b => _item.Status == b.BranchStatus); }
            @if (activeBranch is not null)
            {
                <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mb-2" Style="@activeBranch.BranchStatus.ToOutlinedColorStyle()">
                    @activeBranch.AlertText
                </MudAlert>
            }
            else
            {
                <RepairStepper Status="_item.Status" Source="_item.Source" StatusChanged="SelectStatus" Class="mb-2" />
            }
        </MudItem>

        <MudItem xs="12" md="4">
            <MudExpansionPanels MultiExpansion="true">
                <MudExpansionPanel Text="Item Information" @bind-Expanded="_infoExpanded">
                    <MudTextField @bind-Value="_item.Name" Label="Item Name" Required="true" Class="mb-3" />
                    <MudTextField @bind-Value="_item.SerialNumber" Label="Serial Number (optional)" Class="mb-3" />
                    <MudTextField @bind-Value="_item.BoardVersion" Label="Board Version (optional)" Class="mb-3" />
                    <MudTextField @bind-Value="_item.WarrantyStickerNumber" Label="Warranty Sticker Number (optional)"
                                  MaxLength="10" Validation="@(new Func<string, string?>(ValidateWarrantyStickerNumber))" Class="mb-3" />
                    <MudSelect @bind-Value="_item.Source" Label="Source" Class="mb-3">
                        @foreach (var src in Enum.GetValues<ItemSource>())
                        {
                            <MudSelectItem Value="src">@src.ToDisplayString()</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_item.Source != ItemSource.Repair)
                    {
                        <MudTextField @bind-Value="_item.PurchaseListingId" Label="Purchase Listing ID" Class="mb-3"
                                      Adornment="@(TextLinkifier.IsHttpUrl(_item.PurchaseListingId) ? Adornment.End : Adornment.None)"
                                      AdornmentIcon="@Icons.Material.Filled.OpenInNew" AdornmentColor="Color.Primary"
                                      OnAdornmentClick="@(() => OpenLink(_item.PurchaseListingId))" />
                        <MudDatePicker @bind-Date="_item.PurchaseDate" Label="Purchase Date" Class="mb-3" />
                        <MudTextField @bind-Value="_item.SaleListingId" Label="Sale Listing ID" Class="mb-3"
                                      Adornment="@(TextLinkifier.IsHttpUrl(_item.SaleListingId) ? Adornment.End : Adornment.None)"
                                      AdornmentIcon="@Icons.Material.Filled.OpenInNew" AdornmentColor="Color.Primary"
                                      OnAdornmentClick="@(() => OpenLink(_item.SaleListingId))" />
                        <MudDatePicker @bind-Date="_item.SoldDate" Label="Sold Date" Class="mb-3" />
                    }
                    <MudTextField @bind-Value="_item.GeneralNotes" Label="Notes" Lines="3" Class="mb-3" />
                    <MudTextField @bind-Value="_item.OriginalFault" Label="Original Fault"
                                  Lines="3" />
                </MudExpansionPanel>

                @if (_item.Source != ItemSource.Repair)
                {
                <MudExpansionPanel Text="Financials" @bind-Expanded="_financialsExpanded">
                    <div class="fin-grid mb-4">
                        <MudText Class="fin-label">Purchase Cost</MudText>
                        <div></div>
                        <MudNumericField @bind-Value="_item.Cost" Class="fin-input"
                                         Adornment="Adornment.Start" AdornmentText="$"
                                         Min="0m" Format="F2" />

                        <MudText Class="fin-label">Sales Tax</MudText>
                        <div></div>
                        <MudNumericField @bind-Value="_item.PurchaseTax" Class="fin-input"
                                         Adornment="Adornment.Start" AdornmentText="$"
                                         Min="0m" Format="F2" />

                        <MudText Class="fin-label">Postage</MudText>
                        <MudSwitch @bind-Value="_item.PurchaseShippingPaidByMe" Color="Color.Primary">
                            I paid
                        </MudSwitch>
                        <MudNumericField @bind-Value="_item.PurchaseShipping" Class="fin-input"
                                         Adornment="Adornment.Start" AdornmentText="$"
                                         Min="0m" Format="F2" />

                        <MudText Class="fin-label">Parts Cost</MudText>
                        <div></div>
                        <MudNumericField @bind-Value="_item.Parts" Class="fin-input"
                                         Adornment="Adornment.Start" AdornmentText="$"
                                         Min="0m" Format="F2" />

                        <MudDivider Class="fin-full my-2" />
                        <MudText Typo="Typo.subtitle2" Class="fin-full">Estimated (using @_feePercent% fee)</MudText>

                        <MudText Class="fin-label">Estimated Sell Price</MudText>
                        <div></div>
                        <MudNumericField @bind-Value="_item.EstimatedSellPrice" Class="fin-input"
                                         Adornment="Adornment.Start" AdornmentText="$"
                                         Min="0m" Format="F2" />

                        <MudText Class="fin-label">Reseller Fee</MudText>
                        <div></div>
                        <div class="fin-value">
                            <span>$</span><span>@_item.ResellerFee(_feePercent, _perOrderFee).ToString("F2")</span>
                        </div>

                        <MudText Class="fin-label"><strong>Est. Profit</strong></MudText>
                        <div></div>
                        <div class="fin-value fin-value-bold" style="@($"color:{_item.EstimatedProfit(_feePercent, _perOrderFee).ProfitColor()}")">
                            <span>$</span><span>@_item.EstimatedProfit(_feePercent, _perOrderFee).ToString("F2")</span>
                        </div>

                        <MudDivider Class="fin-full my-2" />
                        <MudText Typo="Typo.subtitle2" Class="fin-full">Actual</MudText>

                        <MudText Class="fin-label">Actual Sell Price</MudText>
                        <div></div>
                        <MudNumericField @bind-Value="_item.ActualSellPrice" Class="fin-input"
                                         Adornment="Adornment.Start" AdornmentText="$"
                                         Min="0m" Format="F2" />

                        <MudText Class="fin-label">Sales Tax</MudText>
                        <div></div>
                        <MudNumericField @bind-Value="_item.SalesTax" Class="fin-input"
                                         Adornment="Adornment.Start" AdornmentText="$"
                                         Min="0m" Format="F2" />

                        <MudText Class="fin-label">Reseller Fee Applies</MudText>
                        <MudSwitch @bind-Value="_item.SellerFeeApplies" Color="Color.Primary" />
                        <div></div>

                        <MudText Class="fin-label">Postage</MudText>
                        <MudSwitch @bind-Value="_item.PostagePaidByMe" Color="Color.Primary">
                            I paid
                        </MudSwitch>
                        <MudNumericField @bind-Value="_item.Postage" Class="fin-input"
                                         Adornment="Adornment.Start" AdornmentText="$"
                                         Min="0m" Format="F2" />

                        <MudText Class="fin-label">Hours Worked</MudText>
                        <div></div>
                        <MudNumericField @bind-Value="_item.HoursWorked" Class="fin-input"
                                         Min="0m" Format="F1" />

                        @if (_item.ActualSellPrice > 0)
                        {
                            <MudDivider Class="fin-full my-2" />

                            <MudText Class="fin-label">Reseller Fee</MudText>
                            <div></div>
                            <div class="fin-value">
                                <span>$</span><span>@_item.ActualResellerFee(_feePercent, _perOrderFee).ToString("F2")</span>
                            </div>

                            <MudText Class="fin-label">Sale Proceeds</MudText>
                            <div></div>
                            <div class="fin-value">
                                <span>$</span><span>@_item.SaleProceeds(_feePercent, _perOrderFee).ToString("F2")</span>
                            </div>

                            <MudText Class="fin-label"><strong>Net Profit</strong></MudText>
                            <div></div>
                            <div class="fin-value fin-value-bold" style="@($"color:{_item.NetProfit(_feePercent, _perOrderFee).ProfitColor()}")">
                                <span>$</span><span>@_item.NetProfit(_feePercent, _perOrderFee).ToString("F2")</span>
                            </div>

                            @if (_item.HourlyProfit(_feePercent, _perOrderFee).HasValue)
                            {
                                <MudText Class="fin-label">Hourly Rate</MudText>
                                <div></div>
                                <div class="fin-value">
                                    <span>$</span><span>@_item.HourlyProfit(_feePercent, _perOrderFee)!.Value.ToString("F2")/hr</span>
                                </div>
                            }
                        }
                    </div>
                </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </MudItem>

        <MudItem xs="12" md="8">
            <RepairLog @ref="_repairLog" Item="_item" IsNew="_isNew" />
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Class="mt-4" Spacing="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Save" Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(_isNew ? "Create Item" : "Save Changes")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Href="/items">
            Cancel
        </MudButton>
        @foreach (var branch in RepairBranch.All)
        {
            @if (!_isNew && _item.Status == branch.BranchStatus)
            {
                <MudButton Variant="Variant.Outlined" OnClick="@(() => EnterOrReturnBranch(branch, enter: false))">
                    @branch.ReturnLabel
                </MudButton>
            }
            else if (!_isNew && branch.AvailableFrom(_item.Status))
            {
                <MudButton Variant="Variant.Outlined" Style="@branch.BranchStatus.ToOutlinedColorStyle()" OnClick="@(() => EnterOrReturnBranch(branch, enter: true))">
                    @branch.EnterLabel
                </MudButton>
            }
        }
        @if (!_isNew && _item.Status != RepairStatus.Intake)
        {
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print"
                       Href="@($"/items/{_item.Id}/report.pdf")" Target="_blank">
                Print Report
            </MudButton>
        }
    </MudStack>
}

@code {
    [Parameter] public string? Id { get; set; }
    [SupplyParameterFromQuery] public decimal Cost { get; set; }
    [SupplyParameterFromQuery] public decimal Parts { get; set; }
    [SupplyParameterFromQuery] public decimal EstimatedSellPrice { get; set; }

    private Item? _item;
    private bool _loading = true;
    private bool _saving;
    private bool _isNew;
    private decimal _feePercent;
    private decimal _perOrderFee;
    private bool _infoExpanded;
    private bool _financialsExpanded;

    private static string? ValidateWarrantyStickerNumber(string value) =>
        !string.IsNullOrEmpty(value) && !value.All(char.IsDigit)
            ? "Must be a number"
            : null;

    // The stepper is non-linear — clicking any step jumps straight to its status.
    private void SelectStatus(RepairStatus status)
    {
        if (_item is null || _item.Status.IsBranch()) return;
        _item.Status = status;
        SetDefaultPanelExpansion();
    }

    private async Task EnterOrReturnBranch(RepairBranch branch, bool enter)
    {
        if (_item is null) return;
        _item.Status = enter ? branch.BranchStatus : branch.ReturnStatus;
        SetDefaultPanelExpansion();
        await Save();
        StateHasChanged();
    }

    private RepairLog? _repairLog;

    private async Task OpenLink(string? url)
    {
        if (TextLinkifier.IsHttpUrl(url))
        {
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetAsync();
        _feePercent = settings.ResellerFeePercentage;
        _perOrderFee = settings.PerOrderFee;

        if (string.IsNullOrEmpty(Id))
        {
            _isNew = true;
            _item = new Item
            {
                Cost = Cost,
                Parts = Parts,
                EstimatedSellPrice = EstimatedSellPrice
            };
        }
        else
        {
            _item = await ItemService.GetByIdAsync(Id);
        }

        SetDefaultPanelExpansion();

        _loading = false;
    }

    private void SetDefaultPanelExpansion()
    {
        if (_item is null) return;

        (_infoExpanded, _financialsExpanded) = _isNew ? (true, true) : _item.Status switch
        {
            RepairStatus.Intake => (true, false),
            RepairStatus.Listed or RepairStatus.Sold => (true, true),
            var s when s.IsBranch() => (true, false),
            _ => (false, false)
        };
    }

    private async Task Save()
    {
        if (_item is null) return;
        _saving = true;

        if (_isNew)
        {
            var note = _repairLog is not null ? await _repairLog.BuildDraftNoteAsync() : null;
            if (note is not null)
            {
                _item.Notes.Add(note);
            }

            await ItemService.CreateAsync(_item);
            Snackbar.Add("Item created", Severity.Success);
            Nav.NavigateTo($"/items/{_item.Id}");
            _isNew = false;
        }
        else
        {
            await ItemService.UpdateAsync(_item);
            Snackbar.Add("Saved", Severity.Success);
        }

        _saving = false;
    }
}
