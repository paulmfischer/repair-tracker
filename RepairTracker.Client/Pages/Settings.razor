@page "/settings"
@inject ISettingsService SettingsService
@inject ISnackbar Snackbar

<PageTitle>Settings</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Settings</MudText>

@if (_settings is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudCard>
        <MudCardContent>
            <MudNumericField @bind-Value="_settings.ResellerFeePercentage"
                             Label="Reseller / Platform Fee %"
                             Min="0m" Max="100m" Step="0.1m" Format="F2"
                             Adornment="Adornment.End" AdornmentText="%"
                             HelperText="Applied when estimating profit in the Calculator and Items views" />
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                       Disabled="_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Save
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    private AppSettings? _settings;
    private bool _saving;

    protected override async Task OnInitializedAsync() =>
        _settings = await SettingsService.GetAsync();

    private async Task Save()
    {
        if (_settings is null) return;
        _saving = true;
        await SettingsService.SaveAsync(_settings);
        _saving = false;
        Snackbar.Add("Settings saved", Severity.Success);
    }
}
