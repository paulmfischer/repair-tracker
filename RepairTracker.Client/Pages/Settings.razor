@page "/settings"
@inject ISettingsService SettingsService
@inject ISnackbar Snackbar

<PageTitle>Settings</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Settings</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_loadError)
{
    <MudAlert Severity="Severity.Error">Couldn't load settings. Check your connection and try again.</MudAlert>
    <MudButton Variant="Variant.Outlined" OnClick="LoadAsync" Class="mt-3">Try Again</MudButton>
}
else if (_settings is not null)
{
    <MudCard>
        <MudCardContent>
            <MudNumericField @ref="_feePercentField" @onfocus="() => SelectAllAsync(_feePercentField)"
                             @bind-Value="_settings.ResellerFeePercentage"
                             Label="Reseller / Platform Fee %"
                             Min="0m" Max="100m" Step="0.1m" Format="F2"
                             Adornment="Adornment.End" AdornmentText="%"
                             HelperText="Applied when estimating profit in the Calculator and Items views" Class="mb-3" />
            <MudNumericField @ref="_perOrderFeeField" @onfocus="() => SelectAllAsync(_perOrderFeeField)"
                             @bind-Value="_settings.PerOrderFee"
                             Label="Per-Order Fee"
                             Min="0m" Format="F2"
                             Adornment="Adornment.Start" AdornmentText="$"
                             HelperText="Flat fee eBay charges per order, on top of the percentage fee" />
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                       Disabled="_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Save
            </MudButton>
        </MudCardActions>
    </MudCard>
}

@code {
    private AppSettings? _settings;
    private bool _loading = true;
    private bool _loadError;
    private bool _saving;

    private MudNumericField<decimal> _feePercentField = null!;
    private MudNumericField<decimal> _perOrderFeeField = null!;

    private static Task SelectAllAsync(MudNumericField<decimal> field) => field.SelectAsync().AsTask();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = false;

        try
        {
            _settings = await SettingsService.GetAsync();
        }
        catch (Exception)
        {
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Save()
    {
        if (_settings is null) return;
        _saving = true;

        try
        {
            await SettingsService.SaveAsync(_settings);
            Snackbar.Add("Settings saved", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("Couldn't save settings. Check your connection and try again.", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
