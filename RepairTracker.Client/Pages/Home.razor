@page "/"
@inject IItemService ItemService
@inject ISettingsService SettingsService

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Dashboard</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_loadError)
{
    <MudAlert Severity="Severity.Error">Couldn't load the dashboard. Check your connection and try again.</MudAlert>
    <MudButton Variant="Variant.Outlined" OnClick="LoadAsync" Class="mt-3">Try Again</MudButton>
}
else if (_stats is not null)
{
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.overline">Est. Total Profit</MudText>
                    <MudText Typo="Typo.h5" Style="@GetColor(_stats.TotalEstimatedProfit)">
                        $@_stats.TotalEstimatedProfit.ToString("F2")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.overline">Actual Total Profit</MudText>
                    <MudText Typo="Typo.h5" Style="@GetColor(_stats.TotalActualProfit)">
                        $@_stats.TotalActualProfit.ToString("F2")
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.overline">Total Postage</MudText>
                    <MudText Typo="Typo.h5">$@_stats.TotalPostage.ToString("F2")</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.overline">Total Hours Worked</MudText>
                    <MudText Typo="Typo.h5">@_stats.TotalHoursWorked.ToString("F1") hrs</MudText>
                    @if (_stats.TotalHoursWorked > 0)
                    {
                        <MudText Typo="Typo.caption">
                            $@(_stats.TotalHoursWorked > 0
                                ? (_stats.TotalActualProfit / _stats.TotalHoursWorked).ToString("F2")
                                : "—")/hr
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mb-3">Items by Status</MudText>
    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudChart ChartType="ChartType.Pie" Width="220px" Height="220px"
                  InputData="@_statusData" InputLabels="@_statusLabels" ChartOptions="@_chartOptions" />
        <MudStack Spacing="1">
            @foreach (var kvp in _stats.StatusCounts)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudChip T="string" Color="@kvp.Key.ToColor()" Style="@kvp.Key.ToColorStyle()" Size="Size.Small">
                        @kvp.Key.ToDisplayString()
                    </MudChip>
                    <MudText Typo="Typo.body2">@kvp.Value</MudText>
                </MudStack>
            }
        </MudStack>
    </MudStack>
}

@code {
    private DashboardStats? _stats;
    private bool _loading = true;
    private bool _loadError;
    private double[] _statusData = [];
    private string[] _statusLabels = [];
    private ChartOptions _chartOptions = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = false;

        try
        {
            var settings = await SettingsService.GetAsync();
            _stats = await ItemService.GetDashboardStatsAsync(settings.ResellerFeePercentage, settings.PerOrderFee);
            _statusData = _stats.StatusCounts.Values.Select(v => (double)v).ToArray();
            _statusLabels = _stats.StatusCounts.Keys.Select(k => k.ToDisplayString()).ToArray();
            _chartOptions = new ChartOptions
            {
                ChartPalette = _stats.StatusCounts.Keys.Select(k => k.ToHex()).ToArray(),
                ShowLegend = false,
            };
        }
        catch (Exception)
        {
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }
    
    private string GetColor(decimal profit) => $"color:{profit.ProfitColor()};";
}
