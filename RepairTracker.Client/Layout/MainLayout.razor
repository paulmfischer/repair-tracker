@using System.Reflection
@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudProviders />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">Repair Tracker</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Class="d-flex flex-column">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Navigation</MudText>
        </MudDrawerHeader>
        <NavMenu />
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="pa-4 mud-text-secondary">
            ver: @_versionLabel
        </MudText>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string _versionLabel = "dev";

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The server bakes GIT_COMMIT into a <meta> tag on the host page, since the
            // Docker image's env var lives on the server process, not the browser running this WASM code.
            var commit = await JS.InvokeAsync<string>("getGitCommitMetaTag");

            if (string.IsNullOrWhiteSpace(commit) || commit == "unknown")
            {
                // Set at build time via RepairTracker.Client.csproj's SetSourceRevisionIdFromGit target,
                // so `dotnet run` locally still shows the commit the running build was compiled from.
                commit = Assembly.GetExecutingAssembly()
                    .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
                    .InformationalVersion.Split('+').ElementAtOrDefault(1);
            }

            if (!string.IsNullOrWhiteSpace(commit))
            {
                _versionLabel = commit.Length > 7 ? commit[..7] : commit;
                StateHasChanged();
            }

            await JS.InvokeVoidAsync("hideAppLoadingScreen");
        }
    }
}
