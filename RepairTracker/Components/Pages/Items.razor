@page "/items"
@rendermode InteractiveServer
@inject IItemService ItemService
@inject ISettingsService SettingsService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Items</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Items</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/items/new">
        New Item
    </MudButton>
</MudStack>

<MudPaper Class="mb-4 pa-3" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
        <MudTextField @bind-Value="_search" Placeholder="Search by name..." Clearable="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" />
        <MudSelect T="RepairStatus?" @bind-Value="_statusFilter" Label="Status" Clearable="true">
            @foreach (var status in Enum.GetValues<RepairStatus>())
            {
                <MudSelectItem T="RepairStatus?" Value="status">@status.ToDisplayString()</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudDataGrid T="Item" Items="FilteredItems" Hover="true" Dense="true"
                 RowClick='e => Nav.NavigateTo($"/items/{e.Item.Id}")'
                 Style="cursor:pointer">
        <Columns>
            <PropertyColumn Property="x => x.Name" Title="Item" />
            <TemplateColumn Title="Source">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small">@context.Item.Source.ToDisplayString()</MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Item.Status)">
                        @context.Item.Status.ToDisplayString()
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Cost">
                <CellTemplate>$@context.Item.Cost.ToString("F2")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Est. Profit">
                <CellTemplate>
                    <span style="color:@(context.Item.EstimatedProfit(_feePercent) >= 0 ? "green" : "red")">
                        $@context.Item.EstimatedProfit(_feePercent).ToString("F2")
                    </span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Net Profit">
                <CellTemplate>
                    @if (context.Item.ActualSellPrice > 0)
                    {
                        <span style="color:@(context.Item.NetProfit >= 0 ? "green" : "red")">
                            $@context.Item.NetProfit.ToString("F2")
                        </span>
                    }
                    else
                    {
                        <span class="mud-text-secondary">—</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Hours">
                <CellTemplate>
                    @if (context.Item.HoursWorked > 0)
                    {
                        @context.Item.HoursWorked.ToString("F1")
                    }
                    else
                    {
                        <span class="mud-text-secondary">—</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="" Sortable="false">
                <CellTemplate>
                    <div @onclick:stopPropagation="true">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="() => DeleteItem(context.Item)" />
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

@code {
    private List<Item> _items = [];
    private bool _loading = true;
    private decimal _feePercent;
    private string _search = string.Empty;
    private RepairStatus? _statusFilter;

    private IEnumerable<Item> FilteredItems => _items
        .Where(i => string.IsNullOrWhiteSpace(_search) ||
                    i.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(i => _statusFilter is null || i.Status == _statusFilter);

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetAsync();
        _feePercent = settings.ResellerFeePercentage;
        _items = await ItemService.GetAllAsync();
        _loading = false;
    }

    private async Task DeleteItem(Item item)
    {
        var result = await DialogService.ShowMessageBox(
            "Confirm Delete",
            $"Delete \"{item.Name}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            await ItemService.DeleteAsync(item.Id);
            _items.Remove(item);
            Snackbar.Add("Item deleted", Severity.Info);
        }
    }

    private static Color StatusColor(RepairStatus status) => status switch
    {
        RepairStatus.Intake => Color.Default,
        RepairStatus.Diagnosis => Color.Warning,
        RepairStatus.PartsOrdered => Color.Info,
        RepairStatus.Repaired => Color.Success,
        RepairStatus.Listed => Color.Primary,
        RepairStatus.Sold => Color.Dark,
        _ => Color.Default
    };
}
