@page "/items/new"
@page "/items/{Id}"
@rendermode InteractiveServer
@inject IItemService ItemService
@inject ISettingsService SettingsService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IWebHostEnvironment Env
@inject IConfiguration Config

<PageTitle>@(_isNew ? "New Item" : _item?.Name ?? "Item")</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/items" />
    <MudText Typo="Typo.h5">@(_isNew ? "New Item" : _item?.Name)</MudText>
</MudStack>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_item is not null)
{
    <MudGrid>
        <MudItem xs="12">
            <MudStepper @bind-ActiveIndex="_statusIndex" NonLinear="true" Class="compact-stepper mb-2">
                @foreach (var status in Enum.GetValues<RepairStatus>())
                {
                    <MudStep Title="@status.ToDisplayString()" Completed="@(status < _item.Status)" />
                }
            </MudStepper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudExpansionPanels MultiExpansion="true">
                <MudExpansionPanel Text="Item Information" @bind-Expanded="_infoExpanded">
                    <MudTextField @bind-Value="_item.Name" Label="Item Name" Required="true" Class="mb-3" />
                    <MudTextField @bind-Value="_item.SerialNumber" Label="Serial Number (optional)" Class="mb-3" />
                    <MudSelect @bind-Value="_item.Source" Label="Source" Class="mb-3">
                        @foreach (var src in Enum.GetValues<ItemSource>())
                        {
                            <MudSelectItem Value="src">@src.ToDisplayString()</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="_item.PurchaseListingId" Label="Purchase Listing ID" Class="mb-3" />
                    <MudTextField @bind-Value="_item.SaleListingId" Label="Sale Listing ID" Class="mb-3" />
                    <MudTextField @bind-Value="_item.GeneralNotes" Label="Notes" Lines="3" Class="mb-3" />
                    <MudTextField @bind-Value="_item.OriginalFault" Label="Original Fault"
                                  Lines="3" />
                </MudExpansionPanel>

                <MudExpansionPanel Text="Financials" @bind-Expanded="_financialsExpanded">
                    <MudNumericField @bind-Value="_item.Cost" Label="Purchase Cost"
                                     Adornment="Adornment.Start" AdornmentText="$"
                                     Min="0m" Format="F2" Class="mb-3" />
                    <MudNumericField @bind-Value="_item.Parts" Label="Parts Cost"
                                     Adornment="Adornment.Start" AdornmentText="$"
                                     Min="0m" Format="F2" Class="mb-3" />
                    <MudNumericField @bind-Value="_item.EstimatedSellPrice" Label="Estimated Sell Price"
                                     Adornment="Adornment.Start" AdornmentText="$"
                                     Min="0m" Format="F2" Class="mb-3" />

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Estimated (using @_feePercent% fee)</MudText>
                    <MudSimpleTable Dense="true" Class="mb-4">
                        <tbody>
                            <tr>
                                <td>Reseller Fee</td>
                                <td>$@_item.ResellerFee(_feePercent).ToString("F2")</td>
                            </tr>
                            <tr>
                                <td><strong>Est. Profit</strong></td>
                                <td style="color:@(_item.EstimatedProfit(_feePercent) >= 0 ? "green" : "red")">
                                    <strong>$@_item.EstimatedProfit(_feePercent).ToString("F2")</strong>
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Actual</MudText>
                    <MudNumericField @bind-Value="_item.ActualSellPrice"
                                     Label="Actual Sell Price (after fees)"
                                     Adornment="Adornment.Start" AdornmentText="$"
                                     Min="0m" Format="F2" Class="mb-3" />
                    <MudNumericField @bind-Value="_item.Postage" Label="Postage"
                                     Adornment="Adornment.Start" AdornmentText="$"
                                     Min="0m" Format="F2" Class="mb-3" />
                    <MudNumericField @bind-Value="_item.HoursWorked" Label="Hours Worked"
                                     Min="0m" Format="F1" Class="mb-3" />

                    @if (_item.ActualSellPrice > 0)
                    {
                        <MudSimpleTable Dense="true">
                            <tbody>
                                <tr>
                                    <td><strong>Net Profit</strong></td>
                                    <td style="color:@(_item.NetProfit >= 0 ? "green" : "red")">
                                        <strong>$@_item.NetProfit.ToString("F2")</strong>
                                    </td>
                                </tr>
                                @if (_item.HourlyProfit.HasValue)
                                {
                                    <tr>
                                        <td>Hourly Rate</td>
                                        <td>$@_item.HourlyProfit!.Value.ToString("F2")/hr</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Repair Log</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTextField @bind-Value="_newNoteText" Label="Note" Lines="3" Class="mb-2" Immediate="true" />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-1">
                        <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                       FilesChanged="OnNewNoteFilesChanged"
                                       Accept=".jpg,.jpeg,.png,.gif,.webp">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AttachFile">
                                    Attach Pictures
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </MudStack>
                    @if (_newNoteFiles.Count > 0)
                    {
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-1">
                            @foreach (var file in _newNoteFiles)
                            {
                                <MudChip T="string" Text="@file.Name" OnClose="@(() => RemoveNewNoteFile(file))" Color="Color.Secondary" Variant="Variant.Text" />
                            }
                        </MudStack>
                    }
                    @if (_isNew)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            This note (and any attached pictures) will be saved when you create the item.
                        </MudText>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                                   OnClick="AddNote" Disabled="@(_addingNote || (string.IsNullOrWhiteSpace(_newNoteText) && _newNoteFiles.Count == 0))">
                            @if (_addingNote)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Add Note
                        </MudButton>
                    }

                    @if (_item.Notes.Any())
                    {
                        <MudDivider Class="my-4" />
                        <MudTimeline TimelinePosition="TimelinePosition.Start">
                            @foreach (var note in _item.Notes.OrderByDescending(n => n.CreatedAt))
                            {
                                <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                                    <ItemContent>
                                        @if (_editingNoteId == note.Id)
                                        {
                                            <MudStack Spacing="2" Class="pb-4">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                                        @note.StatusAtTime.ToDisplayString()
                                                    </MudChip>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @note.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                                    </MudText>
                                                </MudStack>
                                                <MudTextField @bind-Value="_editNoteText" Label="Note" Lines="3" Immediate="true" />
                                                @if (_editImagePaths.Count > 0)
                                                {
                                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                                                        @foreach (var path in _editImagePaths)
                                                        {
                                                            <div style="position:relative;">
                                                                <img src="/@path" alt="Note image"
                                                                     style="height:80px;width:80px;object-fit:cover;border-radius:4px;" />
                                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                                               Color="Color.Error" Variant="Variant.Filled"
                                                                               OnClick="@(() => RemoveEditImage(path))"
                                                                               Style="position:absolute;top:-10px;right:-10px;" />
                                                            </div>
                                                        }
                                                    </MudStack>
                                                }
                                                <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                                               FilesChanged="OnEditNoteFilesChanged"
                                                               Accept=".jpg,.jpeg,.png,.gif,.webp">
                                                    <ActivatorContent>
                                                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AttachFile">
                                                            Attach Pictures
                                                        </MudButton>
                                                    </ActivatorContent>
                                                </MudFileUpload>
                                                @if (_editNewFiles.Count > 0)
                                                {
                                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
                                                        @foreach (var file in _editNewFiles)
                                                        {
                                                            <MudChip T="string" Text="@file.Name" OnClose="@(() => RemoveEditNewFile(file))" Color="Color.Secondary" Variant="Variant.Text" />
                                                        }
                                                    </MudStack>
                                                }
                                                <MudStack Row="true" Spacing="2">
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                               OnClick="@(() => SaveEditNote(note))"
                                                               Disabled="@(_savingEdit || (string.IsNullOrWhiteSpace(_editNoteText) && _editImagePaths.Count == 0 && _editNewFiles.Count == 0))">
                                                        @if (_savingEdit)
                                                        {
                                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                                        }
                                                        Save
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Outlined" OnClick="CancelEditNote" Disabled="_savingEdit">
                                                        Cancel
                                                    </MudButton>
                                                </MudStack>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudStack Spacing="1" Class="pb-4">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                                        @note.StatusAtTime.ToDisplayString()
                                                    </MudChip>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @note.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                                    </MudText>
                                                    <MudSpacer />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                                   OnClick="@(() => StartEditNote(note))" />
                                                </MudStack>
                                                <MudText>@note.Text</MudText>
                                                @if (note.ImagePaths.Any())
                                                {
                                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-1">
                                                        @foreach (var path in note.ImagePaths)
                                                        {
                                                            <a href="/@path" target="_blank">
                                                                <img src="/@path" alt="Note image"
                                                                     style="height:80px;width:80px;object-fit:cover;border-radius:4px;cursor:pointer;" />
                                                            </a>
                                                        }
                                                    </MudStack>
                                                }
                                            </MudStack>
                                        }
                                    </ItemContent>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3">No notes yet.</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Class="mt-4" Spacing="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Save" Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @(_isNew ? "Create Item" : "Save Changes")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Href="/items">
            Cancel
        </MudButton>
    </MudStack>
}

@code {
    [Parameter] public string? Id { get; set; }
    [SupplyParameterFromQuery] public decimal Cost { get; set; }
    [SupplyParameterFromQuery] public decimal Parts { get; set; }
    [SupplyParameterFromQuery] public decimal EstimatedSellPrice { get; set; }

    private Item? _item;
    private bool _loading = true;
    private bool _saving;
    private bool _isNew;
    private decimal _feePercent;
    private bool _infoExpanded;
    private bool _financialsExpanded;

    private int _statusIndex
    {
        get => (int)(_item?.Status ?? RepairStatus.Intake);
        set
        {
            if (_item is null) return;
            _item.Status = (RepairStatus)value;
            SetDefaultPanelExpansion();
        }
    }

    private string _newNoteText = string.Empty;
    private List<IBrowserFile> _newNoteFiles = new();
    private bool _addingNote;

    private void OnNewNoteFilesChanged(IReadOnlyList<IBrowserFile> files)
    {
        _newNoteFiles.AddRange(files);
    }

    private void RemoveNewNoteFile(IBrowserFile file)
    {
        _newNoteFiles.Remove(file);
    }

    protected override async Task OnInitializedAsync()
    {
        var settings = await SettingsService.GetAsync();
        _feePercent = settings.ResellerFeePercentage;

        if (string.IsNullOrEmpty(Id))
        {
            _isNew = true;
            _item = new Item
            {
                Cost = Cost,
                Parts = Parts,
                EstimatedSellPrice = EstimatedSellPrice
            };
        }
        else
        {
            _item = await ItemService.GetByIdAsync(Id);
        }

        SetDefaultPanelExpansion();

        _loading = false;
    }

    private void SetDefaultPanelExpansion()
    {
        if (_item is null) return;

        (_infoExpanded, _financialsExpanded) = _isNew ? (true, true) : _item.Status switch
        {
            RepairStatus.Intake => (true, false),
            RepairStatus.Listed or RepairStatus.Sold => (true, true),
            _ => (false, false)
        };
    }

    private string GetUploadsRoot() =>
        Config["Uploads:Path"] is { Length: > 0 } p ? p : Path.Combine(Env.WebRootPath, "uploads");

    private async Task UploadNoteFilesAsync(RepairNote note, IEnumerable<IBrowserFile> files)
    {
        var uploadsRoot = GetUploadsRoot();
        var uploadDir = Path.Combine(uploadsRoot, _item!.Id, note.Id);
        Directory.CreateDirectory(uploadDir);

        foreach (var file in files)
        {
            var safeName = Path.GetFileName(file.Name);
            var dest = Path.Combine(uploadDir, safeName);
            await using var stream = File.Create(dest);
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(stream);
            note.ImagePaths.Add($"uploads/{_item.Id}/{note.Id}/{safeName}");
        }
    }

    private void DeleteNoteImageFromDisk(string imagePath)
    {
        var uploadsRoot = GetUploadsRoot();
        var relative = imagePath.StartsWith("uploads/") ? imagePath["uploads/".Length..] : imagePath;
        var fullPath = Path.Combine(uploadsRoot, relative);
        if (File.Exists(fullPath))
        {
            File.Delete(fullPath);
        }
    }

    private async Task<RepairNote?> BuildDraftNoteAsync()
    {
        if (_item is null) return null;
        if (string.IsNullOrWhiteSpace(_newNoteText) && _newNoteFiles.Count == 0) return null;

        var note = new RepairNote
        {
            Text = _newNoteText.Trim(),
            StatusAtTime = _item.Status,
            CreatedAt = DateTime.UtcNow
        };

        if (_newNoteFiles.Count > 0)
        {
            await UploadNoteFilesAsync(note, _newNoteFiles);
        }

        _newNoteText = string.Empty;
        _newNoteFiles = new();
        return note;
    }

    private async Task AddNote()
    {
        if (_item is null) return;
        _addingNote = true;

        var note = await BuildDraftNoteAsync();
        if (note is not null)
        {
            _item.Notes.Add(note);
            await ItemService.UpdateAsync(_item);
            Snackbar.Add("Note added", Severity.Success);
        }

        _addingNote = false;
    }

    private string? _editingNoteId;
    private string _editNoteText = string.Empty;
    private List<string> _editImagePaths = new();
    private List<string> _editRemovedImagePaths = new();
    private List<IBrowserFile> _editNewFiles = new();
    private bool _savingEdit;

    private void StartEditNote(RepairNote note)
    {
        _editingNoteId = note.Id;
        _editNoteText = note.Text;
        _editImagePaths = new List<string>(note.ImagePaths);
        _editRemovedImagePaths = new();
        _editNewFiles = new();
    }

    private void CancelEditNote()
    {
        _editingNoteId = null;
        _editNoteText = string.Empty;
        _editImagePaths = new();
        _editRemovedImagePaths = new();
        _editNewFiles = new();
    }

    private void RemoveEditImage(string path)
    {
        _editImagePaths.Remove(path);
        _editRemovedImagePaths.Add(path);
    }

    private void OnEditNoteFilesChanged(IReadOnlyList<IBrowserFile> files)
    {
        _editNewFiles.AddRange(files);
    }

    private void RemoveEditNewFile(IBrowserFile file)
    {
        _editNewFiles.Remove(file);
    }

    private async Task SaveEditNote(RepairNote note)
    {
        if (_item is null) return;
        _savingEdit = true;

        note.Text = _editNoteText.Trim();
        note.ImagePaths = _editImagePaths;

        if (_editNewFiles.Count > 0)
        {
            await UploadNoteFilesAsync(note, _editNewFiles);
        }

        foreach (var removed in _editRemovedImagePaths)
        {
            DeleteNoteImageFromDisk(removed);
        }

        await ItemService.UpdateAsync(_item);
        Snackbar.Add("Note updated", Severity.Success);

        CancelEditNote();
        _savingEdit = false;
    }

    private async Task Save()
    {
        if (_item is null) return;
        _saving = true;

        if (_isNew)
        {
            var note = await BuildDraftNoteAsync();
            if (note is not null)
            {
                _item.Notes.Add(note);
            }

            await ItemService.CreateAsync(_item);
            Snackbar.Add("Item created", Severity.Success);
            Nav.NavigateTo($"/items/{_item.Id}");
            _isNew = false;
        }
        else
        {
            await ItemService.UpdateAsync(_item);
            Snackbar.Add("Saved", Severity.Success);
        }

        _saving = false;
    }
}
