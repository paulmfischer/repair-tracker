@rendermode InteractiveServer

<MudThemeProvider IsDarkMode="true" Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {
    // Color.Tertiary isn't used anywhere else in the app, so it's repurposed here as the
    // dedicated Intake status color.
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Tertiary = "#d16084",
            TertiaryContrastText = "#FFFFFF"
        },
        PaletteLight = new PaletteLight
        {
            Tertiary = "#d16084",
            TertiaryContrastText = "#FFFFFF"
        }
    };
}
